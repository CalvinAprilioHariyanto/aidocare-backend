generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  APPOINTMENT_STATUS_UPDATED
  QUEUE_STATUS_UPDATED
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  role          UserRole
  patient       Patient?
  doctor        Doctor?
  notifications Notification[]
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
}

model Patient {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @unique @db.Uuid
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  dateOfBirth    DateTime?       @db.Date
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(6)
}

model Doctor {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @unique @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber  String           @unique
  bio            String?
  specialties    Specialty[]
  schedules      DoctorSchedule[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)
}

model Specialty {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  doctors   Doctor[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model DoctorSchedule {
  id        String    @id @default(uuid()) @db.Uuid
  doctorId  String    @db.Uuid
  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime DateTime  @db.Time(0)
  endTime   DateTime  @db.Time(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([doctorId, dayOfWeek, isActive])
}

model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  patientId       String            @db.Uuid
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctorId        String            @db.Uuid
  doctor          Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointmentDate DateTime          @db.Date
  startTime       DateTime          @db.Time(0)
  status          AppointmentStatus @default(PENDING)
  queueNumber     Int?
  queueStatus     QueueStatus       @default(WAITING)
  cancelledAt     DateTime?         @db.Timestamptz(6)
  notifications   Notification[]
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)

  @@unique([doctorId, appointmentDate, queueNumber])
  @@index([patientId, appointmentDate])
  @@index([doctorId, appointmentDate, startTime])
}

model MedicalRecord {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String   @db.Uuid
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
}

model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  userId        String           @db.Uuid
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId String?          @db.Uuid
  appointment   Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  type          NotificationType
  message       String
  readAt        DateTime?        @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([appointmentId])
}
